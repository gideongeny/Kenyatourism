    <!-- About -->
    <string name="about_title">About Tembea Kenya</string>
    <string name="about_vision">Our Vision</string>
    <string name="about_vision_text">To be the definitive digital companion for exploring Kenya\'s rich cultural heritage, stunning landscapes, and diverse wildlife — making every corner of this beautiful nation accessible to travelers worldwide.</string>
    <string name="about_goal">Our Goal</string>
    <string name="about_goal_text">Tembea Kenya aims to connect travelers with authentic Kenyan experiences by providing comprehensive, curated, and up-to-date information about destinations across all 47 counties. We believe every journey begins with inspiration, and we are here to spark yours.</string>
    
    <!-- Privacy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_text">Tembea Kenya respects your privacy. We collect only the minimum data necessary to provide you with the best travel experience:\n\n• Account data (email, display name) when you sign in\n• Your saved destinations and preferences\n• Anonymous usage analytics to improve the app\n\nWe never sell your personal information to third parties. Your data is stored securely using Google Firebase infrastructure. You can delete your account and all associated data at any time by contacting us.\n\nFor questions about your data, contact us at gideongeng@gmail.com</string>
    
    <!-- Guidelines -->
    <string name="guidelines_title">Community Guidelines</string>
    <string name="guidelines_text">Welcome to the Tembea Kenya community! To keep this a safe and positive space for all travelers:\n\n1. Be respectful — Treat fellow travelers and local communities with kindness\n2. Share authentic experiences — Post honest reviews and real photos\n3. Respect local cultures — Be mindful of traditions and customs\n4. Protect wildlife — Never disturb animals or their habitats\n5. Leave no trace — Help preserve Kenya\'s natural beauty\n6. Report issues — Flag inappropriate content or safety concerns\n\nViolations may result in account restrictions.</string>
    
